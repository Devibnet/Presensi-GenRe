# ==============================================================================
# GENRE ATTENDANCE - SUPABASE ENVIRONMENT VARIABLES
# Pemilihan Duta GenRe Kabupaten Buleleng
# ==============================================================================

# 1. URL Proyek Supabase Anda (Dapatkan dari Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Public Anonymous Key (Aman digunakan di browser client)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 3. Secret Service Role Key (HANYA digunakan di Server/API Routes backend, JANGAN diekspos ke browser!)
# Digunakan untuk: Pembuatan akun panitia massal via CSV & operasi administratif bypass RLS
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 4. Zona Waktu Standar Aplikasi
NEXT_PUBLIC_TIMEZONE=Asia/Makassar
